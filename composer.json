{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ruangaman/ruangaman-app",
    "type": "project",
    "description": "Aplikasi Web untuk Pelaporan, Konseling, dan Penanganan Kekerasan Berbasis Gender.",
    "keywords": ["laravel", "framework", "ruangaman", "gender-based-violence", "privacy"],
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
